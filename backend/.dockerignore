# Exclude everything by default
**

# Production dependencies
!pyproject.toml
!uv.lock
!.python-version

# Application source code
!api/
!api/**

# Local environment
!alembic.ini
!alembic/
!alembic/**
!scripts/
!scripts/**
!data/
!data/**
!create_dev_user.py

# Python artifacts
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.ruff_cache/

# Environment and credentials
**/.env
**/.env.*
**/*.pem
**/*.key
**/*credentials*.json
**/*service-account*.json